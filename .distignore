# Files that must not reach a distributed build of the plugin.
#
# Read by `wp dist-archive` and by the WordPress.org deploy action. The
# matching list for GitHub's own generated source archives is in
# .gitattributes, which has to be kept in step with this file.
#
# The result is the runtime only: the plugin bootstrap, includes/, assets/,
# readme.txt, README.md, LICENSE and uninstall.php.

/.distignore
/.gitattributes
/.gitignore
/.github
/tests
